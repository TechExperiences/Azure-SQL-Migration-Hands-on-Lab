# Deployment context
TEMPLATE_FILE_NAME=infra.bicep
RESOURCE_GROUP_NAME=
LOCATION=eastus
SUFFIX=

# SQL admin and credentials
SQL_ADMIN_LOGIN=sqladmin
SQL_ADMIN_PASSWORD_LENGTH=16
SQL_PASSWORD_CHARSET=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%
SQL_CREDENTIALS_DIR=C:\SQL_Credentials

# Region preferences (comma- or semicolon-separated)
SQL_REGION_CANDIDATES=westus,westus2,centralus
DMS_REGION_CANDIDATES=westus,westus2,centralus

# Optional existing DMS subnet id; leave blank for auto-discovery/auto-create
DMS_VIRTUAL_SUBNET_ID=

# SQL & DMS service properties
SQL_SERVER_VERSION=12.0
SQL_PUBLIC_NETWORK_ACCESS=Enabled
SQL_DATABASE_SKU_NAME=Basic
SQL_DATABASE_SKU_TIER=Basic
SQL_DATABASE_SKU_CAPACITY=5
SQL_BACKUP_STORAGE_REDUNDANCY=Local
DMS_SKU_NAME=Premium_4vCores
DMS_SKU_TIER=Premium

# Firewall behavior
SQL_CLIENT_FIREWALL_RULE_PREFIX=client-ip
AZURE_SERVICES_FIREWALL_RULE_NAME=AllowAllWindowsAzureIps
PUBLIC_IP_SOURCES=https://api.ipify.org,https://ifconfig.me/ip,https://checkip.amazonaws.com

# Deployment polling
DEPLOYMENT_POLL_INTERVAL_SECONDS=20
DEPLOYMENT_TIMEOUT_MINUTES=90

# Auto-created network defaults
DMS_VNET_NAME_PREFIX=vnet-dms
DMS_VNET_ADDRESS_PREFIX=10.250.0.0/16
DMS_SUBNET_NAME=snet-dms
DMS_SUBNET_ADDRESS_PREFIX=10.250.1.0/24
DMS_ALT_SUBNET_NAME=snet-dms-auto
DMS_ALT_SUBNET_ADDRESS_PREFIX=10.250.2.0/24

# Auto-created resource-group naming
AUTO_RESOURCE_GROUP_NAME_PREFIX=rg-sql-dms
AUTO_RESOURCE_GROUP_RANDOM_MAX=9999

# Suffix and token generation
SUFFIX_RANDOM_MIN=100
SUFFIX_RANDOM_MAX=999
SUFFIX_FALLBACK_TEXT=sql
CUSTOM_SUFFIX_MAX_BASE_LENGTH=8
SUFFIX_TIME_FORMAT=MMddHHmm
RG_TOKEN_MAX_LENGTH=12
RG_TOKEN_FALLBACK_TEXT=rg
DEFAULT_REGION_IF_NONE=eastus

# Credentials file format
CREDENTIALS_FILE_PREFIX=sql_credentials
CREDENTIALS_TIMESTAMP_FORMAT=yyyyMMdd-HHmmss
CREDENTIALS_CREATED_UTC_FORMAT=yyyy-MM-ddTHH:mm:ssZ

# Name templates used by deploy.ps1
SQL_SERVER_NAME_TEMPLATE=sql-{rgToken}-f{attempt}-{suffix}
SQL_DATABASE_NAME_TEMPLATE=sqldb-{rgToken}-f{attempt}-{suffix}
DMS_SERVICE_NAME_TEMPLATE=dms-{rgToken}-f{attempt}-{suffix}
SQL_SERVER_NAME_MAX_LENGTH=60
SQL_DATABASE_NAME_MAX_LENGTH=128
DMS_SERVICE_NAME_MAX_LENGTH=63

# Bicep naming controls passed by deploy.ps1
BICEP_RUN_DATETIME=__AUTO_UTC_NOW__
BICEP_GENERATED_SUFFIX_LENGTH=10
BICEP_RG_TOKEN_LENGTH=12
BICEP_DEPLOYMENT_ATTEMPT_LABEL=f1

# Deployment flow controls
SQL_DEPLOYMENT_PREFIX=sql
DMS_DEPLOYMENT_PREFIX=dms
SQL_DEPLOYMENT_LABEL=Azure SQL Server + Database
DMS_DEPLOYMENT_LABEL=Azure Database Migration Service
SQL_RESOURCE_TYPE=Microsoft.Sql/servers
DMS_RESOURCE_TYPE=Microsoft.DataMigration/services
SQL_LOCATION_PARAM_NAME=sqlLocation
DMS_LOCATION_PARAM_NAME=dmsLocation
SQL_OUTPUT_RESOURCE_NAME_KEY=sqlServerName
DMS_OUTPUT_RESOURCE_NAME_KEY=dmsServiceName
DEPLOY_SQL_FOR_SQL_STEP=true
DEPLOY_DMS_FOR_SQL_STEP=false
DEPLOY_SQL_FOR_DMS_STEP=false
DEPLOY_DMS_FOR_DMS_STEP=true
